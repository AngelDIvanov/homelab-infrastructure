# Generated by terraform (terraform-kubeadm/templates/inventory.ini.tftpl); do not edit by hand.
[kubeadm_control]
${control_hostname} ansible_host=${control_ip}

[kubeadm_workers]
%{ for name, ip in workers ~}
${name} ansible_host=${ip}
%{ endfor ~}

[kubeadm_all:children]
kubeadm_control
kubeadm_workers

[kubeadm_all:vars]
ansible_user=labadmin
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_ssh_common_args='-o StrictHostKeyChecking=yes -o UserKnownHostsFile={{ inventory_dir }}/known_hosts'
