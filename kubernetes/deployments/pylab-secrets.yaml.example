# Template for the pylab Secret — never commit real values.
#
# Copy, fill in real values, apply, then delete the copy:
#   install -m 600 kubernetes/deployments/pylab-secrets.yaml.example /tmp/pylab-secrets.yaml
#   ${EDITOR:-vi} /tmp/pylab-secrets.yaml
#   kubectl apply -f /tmp/pylab-secrets.yaml && rm /tmp/pylab-secrets.yaml
#
# The Deployment (pylab.yaml) injects DB_URL and API_KEY from this Secret via
# required secretKeyRef entries. Running pods keep their environment, so
# deleting or renaming the Secret does not affect them; replacement pods
# (rollout, restart, reschedule) fail with CreateContainerConfigError until
# the Secret exists again (intentional chaos-engineering scenario).
apiVersion: v1
kind: Secret
metadata:
  name: pylab-secrets
  namespace: pylab
type: Opaque
stringData:
  DB_URL: "postgresql://pylab:REPLACE_ME@postgres.pylab.svc:5432/pylab"
  API_KEY: "REPLACE_ME"
