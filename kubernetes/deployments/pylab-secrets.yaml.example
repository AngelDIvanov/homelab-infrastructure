# Template for the pylab Secret — never commit real values.
#
# Copy, fill in real values, apply, then delete the copy:
#   cp kubernetes/deployments/pylab-secrets.yaml.example /tmp/pylab-secrets.yaml
#   ${EDITOR:-vi} /tmp/pylab-secrets.yaml
#   kubectl apply -f /tmp/pylab-secrets.yaml && rm /tmp/pylab-secrets.yaml
#
# The Deployment (pylab.yaml) injects DB_URL and API_KEY from this Secret via
# secretKeyRef. Deleting or renaming the Secret in-cluster makes /ready return
# 503 — pods go NotReady and are removed from Service endpoints (intentional
# chaos-engineering behaviour for testing the readiness gate).
apiVersion: v1
kind: Secret
metadata:
  name: pylab-secrets
  namespace: pylab
type: Opaque
stringData:
  DB_URL: "postgresql://pylab:REPLACE_ME@postgres.pylab.svc:5432/pylab"
  API_KEY: "REPLACE_ME"
