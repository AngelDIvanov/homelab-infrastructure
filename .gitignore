# Terraform state — contains sensitive data, never commit
*.tfstate
*.tfstate.backup

# Terraform working files
**/.terraform/
**/.terraform.lock.hcl

# terraform.tfvars contains your SSH key and IPs — use terraform.tfvars.example as a template
terraform/terraform.tfvars
terraform-kubeadm/terraform.tfvars

# Network config contains real IPs — use lab-network-config.example.yaml as a template
kubernetes/monitoring/lab-network-config.yaml

# Python
__pycache__/
*.pyc

# Secrets / session caches
.secrets_cache
.bw_session
*.env
.env*

# Editor
.vscode/
.idea/
*.swp

# Claude Code local settings
**/.claude/

# Generated / binary / internal files
homelab-summary.html
monitoring/grafana/files.zip
scripts/options}
terraform/env.sh

# ── SECRET-BEARING FILES — NEVER COMMIT (added 2026-06-13 after public-leak incident) ──
# SSH private keys / any keypair
gitlab
gitlab.pub
*.pem
id_rsa*
id_ed25519*
*.key
# Alertmanager config holds live Slack webhook URLs
scripts/alertmanager.yaml
# Vault init output (unseal keys + root token)
**/init.json
# Any file with embedded tokens — keep secrets in env/Vaultwarden via _get_secret()
*token*.txt
.secrets
